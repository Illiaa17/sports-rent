<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sport_rent.ViewModels"
             x:DataType="vm:SettingsViewModel"
             x:Class="sport_rent.Views.SettingsView">

    <ScrollViewer>
        <StackPanel Spacing="20" Margin="0,0,0,30" MaxWidth="640" HorizontalAlignment="Left">
            <TextBlock Classes="h1" Text="{Binding Loc[SettingsTitle]}"/>

            
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="{Binding Loc[LanguageSection]}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary" Content="Українська"
                                Command="{Binding ChangeLanguageCommand}" CommandParameter="uk"/>
                        <Button Classes="ghost" Content="English"
                                Command="{Binding ChangeLanguageCommand}" CommandParameter="en"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="{Binding Loc[ThemeSection]}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="primary"
                                Content="{Binding Loc[ToggleThemeBtn]}"
                                Command="{Binding ToggleThemeCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            
            <Border Classes="card">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="{Binding Loc[FineSection]}"/>
                    <StackPanel Spacing="12" MaxWidth="360">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="form-label" Text="{Binding Loc[FinePerDayLabel]}"/>
                            <NumericUpDown Value="{Binding FinePerDay}"
                                           Minimum="0" Maximum="10000"
                                           FormatString="F2"
                                           HorizontalAlignment="Stretch"/>
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="form-label" Text="{Binding Loc[DamageFinePercentLabel]}"/>
                            <NumericUpDown Value="{Binding DamageFinePercent}"
                                           Minimum="0" Maximum="500"
                                           FormatString="F0"
                                           HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
