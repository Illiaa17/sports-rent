<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:sport_rent.ViewModels"
             xmlns:svc="clr-namespace:sport_rent.Services"
             xmlns:controls="clr-namespace:sport_rent.Controls"
             x:DataType="vm:EquipmentViewModel"
             x:Class="sport_rent.Views.EquipmentView">

    <Grid ColumnDefinitions="*,360" RowDefinitions="Auto,Auto,*,Auto">

        <TextBlock Classes="h1" Text="{Binding Loc[EquipmentTitle]}"
                   Grid.ColumnSpan="2" Margin="0,0,0,14"/>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12"
                    VerticalAlignment="Center">
            <controls:FloatingLabelBox Text="{Binding SearchText}"
                                       Label="{Binding Loc[SearchEquipmentWatermark]}"
                                       Compact="True"
                                       Width="360"
                                       VerticalAlignment="Center"/>
            <Button Classes="ghost"
                    Content="{Binding Loc[ExportCsvBtn]}"
                    Command="{Binding ExportCsvCommand}"
                    MinHeight="38"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Equipment cards -->
        <Border Grid.Row="2" Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource Border}" BorderThickness="1"
                CornerRadius="10" ClipToBounds="True">
            <Panel>
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              IsVisible="{Binding !HasNoData}">
                    <ItemsControl ItemsSource="{Binding EquipmentCards}" Margin="12" x:CompileBindings="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:EquipmentCardViewModel">
                                <Button Classes="equipment-card"
                                        Classes.selected="{Binding IsSelected}"
                                        Command="{Binding $parent[UserControl].((vm:EquipmentViewModel)DataContext).SelectEquipmentCommand}"
                                        CommandParameter="{Binding Equipment}"
                                        Width="300" Margin="0,0,16,16"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch">
                                    <Border Classes="equipment-card-inner">
                                        <StackPanel Spacing="0">
                                            <Border Height="170"
                                                    CornerRadius="8,8,0,0"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource SurfaceAlt}">
                                                <Panel>
                                                    <Image Source="{Binding Image}"
                                                           Stretch="Uniform"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding HasImage}"/>
                                                    <TextBlock Text="{ReflectionBinding [NoImageLabel], Source={x:Static svc:LocalizationService.Instance}}"
                                                               Foreground="{DynamicResource TextLo}"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasImage}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Spacing="6" Margin="16,14,16,16">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextHi}"
                                                           TextWrapping="Wrap"
                                                           LineHeight="22"/>
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextLo}"
                                                           TextWrapping="Wrap"/>
                                                <StackPanel Spacing="3" Margin="0,4,0,0">
                                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextLo}" TextWrapping="Wrap">
                                                        <Run Text="{ReflectionBinding [ColDailyRate], Source={x:Static svc:LocalizationService.Instance}}"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding DailyRateText}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextLo}" TextWrapping="Wrap">
                                                        <Run Text="{ReflectionBinding [ColDeposit], Source={x:Static svc:LocalizationService.Instance}}"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding DepositText}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextLo}" TextWrapping="Wrap">
                                                        <Run Text="{ReflectionBinding [ColQty], Source={x:Static svc:LocalizationService.Instance}}"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding Quantity}"/>
                                                    </TextBlock>
                                                    <TextBlock FontSize="13" Foreground="{DynamicResource TextLo}" TextWrapping="Wrap">
                                                        <Run Text="{ReflectionBinding [ColCondition], Source={x:Static svc:LocalizationService.Instance}}"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding Condition}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="{Binding Loc[NoData]}"
                           Foreground="{DynamicResource TextLo}" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding HasNoData}"/>
            </Panel>
        </Border>

        <!-- Pagination -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0" VerticalAlignment="Center">
            <Button Classes="ghost icon-btn" Command="{Binding PrevPageCommand}"
                    ToolTip.Tip="{Binding Loc[PrevPage]}">
                <PathIcon Data="M 7 2 L 2 8 L 7 14" Width="10" Height="14"/>
            </Button>
            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextLo}" MinWidth="80" TextAlignment="Center">
                <Run Text="{Binding Loc[PageLabel]}"/><Run Text=" "/><Run Text="{Binding CurrentPage}"/><Run Text=" "/><Run Text="{Binding Loc[OfLabel]}"/><Run Text=" "/><Run Text="{Binding TotalPages}"/>
            </TextBlock>
            <Button Classes="ghost icon-btn" Command="{Binding NextPageCommand}"
                    ToolTip.Tip="{Binding Loc[NextPage]}">
                <PathIcon Data="M 2 2 L 7 8 L 2 14" Width="10" Height="14"/>
            </Button>
            <TextBlock Text="{Binding Loc[PageSizeLabel]}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource TextLo}"/>
            <ComboBox ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" Width="74" Height="32" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Edit form -->
        <Border Grid.Column="1" Grid.Row="1" Grid.RowSpan="3"
                Classes="card" Margin="18,0,0,0">
            <ScrollViewer>
                <StackPanel Spacing="12">

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                        <TextBlock Grid.Column="0"
                                   Classes="h2"
                                   Text="{Binding FormTitle}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,12,0"/>
                        <Button Grid.Column="1"
                                Classes="ghost"
                                Content="{Binding Loc[NewBtn]}"
                                Command="{Binding NewEquipmentCommand}"
                                Padding="10,4"
                                VerticalAlignment="Center"/>
                    </Grid>

                    <controls:FloatingLabelBox Text="{Binding SelectedEquipment.Name}"
                                               Label="{Binding Loc[NameWatermark]}"/>
                    <controls:FloatingLabelAutoComplete Text="{Binding SelectedEquipment.Category}"
                                                        ItemsSource="{Binding CategoryOptions}"
                                                        Label="{Binding Loc[CategoryWatermark]}"/>

                    <Grid ColumnDefinitions="*,8,*">
                        <controls:FloatingLabelBox Text="{Binding SelectedEquipment.DailyRate}"
                                                   Label="{Binding Loc[DailyRateWatermark]}"/>
                        <controls:FloatingLabelBox Grid.Column="2"
                                                   Text="{Binding SelectedEquipment.DepositAmount}"
                                                   Label="{Binding Loc[DepositWatermark]}"/>
                    </Grid>

                    <Grid ColumnDefinitions="*,8,*">
                        <controls:FloatingLabelBox Text="{Binding SelectedEquipment.Quantity}"
                                                   Label="{Binding Loc[QuantityWatermark]}"/>
                        <controls:FloatingLabelAutoComplete Grid.Column="2"
                                                            Text="{Binding SelectedEquipment.Condition}"
                                                            ItemsSource="{Binding ConditionOptions}"
                                                            Label="{Binding Loc[ConditionWatermark]}"/>
                    </Grid>

                    <TextBlock Classes="muted" Text="{Binding Loc[ImageSection]}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    <Button Classes="ghost" Content="{Binding Loc[BrowseBtn]}"
                            x:Name="BrowseButton"
                            Click="BrowseButton_Click"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8"
                            IsVisible="{Binding SelectedImage, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Image Source="{Binding SelectedImage}" Height="120" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="{Binding ValidationError}"
                               Classes="danger"
                               IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextWrapping="Wrap"/>

                    <Grid ColumnDefinitions="*,8,*" Margin="0,4,0,0">
                        <Button Classes="primary" Grid.Column="0"
                                Content="{Binding Loc[SaveBtn]}"
                                Command="{Binding SaveEquipmentCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Classes="danger" Grid.Column="2"
                                Content="{Binding Loc[DeleteBtn]}"
                                Command="{Binding DeleteEquipmentCommand}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
